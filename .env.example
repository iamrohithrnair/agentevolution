# Copy to `.env` and fill in values. `.env` is gitignored.

# Next.js (in `frontend/`) reads this file via dotenv (`frontend/lib/mongo-atlas-env.ts`) so you share one Mongo config with Python.

# pymongo expects one URI string (Atlas: Connect → Drivers → Python). Replace YOUR_PASSWORD with
# the password for DB user `aiagent`. URL-encode the password if it contains @ # : % etc.

MONGODB_URI=mongodb+srv://aiagent:YOUR_PASSWORD@cluster0.de5qma.mongodb.net/?retryWrites=true&w=majority

# Alternative env names atlas_ping accepts (only one URI is required):
# MONGODB_ATLAS_URI=mongodb+srv://...
# ATLAS_CONNECTION_STRING=mongodb+srv://...

# --- Corporate TLS (SSL inspection): PyMongo TLS options ---
#
# PEM bundle trusted by pymongo (`tlsCAFile`). Often your enterprise root/intermediate certs in one `.pem`,
# or the same bundle IT documents for HTTPS (curl's --cacert / browser “export root”).

## PEM bundle (`$HOME`, `~`, and env vars expanded by the OS)
MONGODB_TLS_CA_FILE=$HOME/combined-cert-bundle.pem

## Alternative — absolute path:
## MONGODB_TLS_CA_FILE=/absolute/path/to/corporate-bundle.pem

# If your workstation already defines this for Python/curl, atlas_ping forwards it unless you omit it:

## SSL_CERT_FILE=/absolute/path/to/corporate-bundle.pem

# Last resort only — disables verification (insecure):

## MONGODB_TLS_ALLOW_INVALID=1

# --- Next.js `GET /api/mongo/ping`: include stack traces in error JSON (avoid in prod) ---
#
## MONGO_PING_VERBOSE_ERRORS=1

# ──────────────────────────────────────────────────────────
# Dronan — additional configuration
# ──────────────────────────────────────────────────────────
MONGODB_DB=dronan
MONGODB_REPL_SET=

# Atlas Admin (vector index management via API)
ATLAS_PROJECT_ID=
ATLAS_PRIVATE_KEY=
ATLAS_PUBLIC_KEY=
ATLAS_CLUSTER_NAME=Cluster0

# Voyage AI (embeddings — default 1024-dim voyage-3-large; Matryoshka 256|1024|2048)
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-3-large
VOYAGE_DIM=1024

# LLM (provider-agnostic — routed through langchain.chat_models.init_chat_model)
#
# Provider options: openai | anthropic | google_genai | groq | ollama | azure_openai
# Switch provider by changing LLM_PROVIDER and LLM_*_MODEL; supply the corresponding
# API key (OPENAI_API_KEY / ANTHROPIC_API_KEY / GOOGLE_API_KEY / GROQ_API_KEY / ...).
LLM_PROVIDER=google_genai
GOOGLE_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite-preview
LLM_PLANNER_MODEL=gemini-3.1-flash-lite-preview
LLM_REFLECTION_MODEL=gemini-3.1-flash-lite-preview
# Alt providers (fill corresponding key):
# ANTHROPIC_API_KEY=
# GROQ_API_KEY=
# AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Voice stack
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Optional integrations
OPENWEATHER_API_KEY=
GOOGLE_MAPS_API_KEY=
AIRSIM_ENABLED=false
PX4_ENABLED=false

# App
APP_ENV=demo
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
LOG_LEVEL=INFO

# Queryable Encryption
QE_KMS_PROVIDER=local
QE_LOCAL_KEY=
