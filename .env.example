# Copy to `.env` and fill in values. `.env` is gitignored.

# Next.js (in `frontend/`) reads this file via dotenv (`frontend/lib/mongo-atlas-env.ts`) so you share one Mongo config with Python.

# pymongo expects one URI string (Atlas: Connect → Drivers → Python). Replace YOUR_PASSWORD with
# the password for DB user `aiagent`. URL-encode the password if it contains @ # : % etc.

MONGODB_URI=mongodb+srv://aiagent:YOUR_PASSWORD@cluster0.de5qma.mongodb.net/?retryWrites=true&w=majority

# Alternative env names atlas_ping accepts (only one URI is required):
# MONGODB_ATLAS_URI=mongodb+srv://...
# ATLAS_CONNECTION_STRING=mongodb+srv://...

# --- Corporate TLS (SSL inspection): PyMongo TLS options ---
#
# PEM bundle trusted by pymongo (`tlsCAFile`). Often your enterprise root/intermediate certs in one `.pem`,
# or the same bundle IT documents for HTTPS (curl's --cacert / browser “export root”).

## PEM bundle (`$HOME`, `~`, and env vars expanded by the OS)
MONGODB_TLS_CA_FILE=$HOME/combined-cert-bundle.pem

## Alternative — absolute path:
## MONGODB_TLS_CA_FILE=/absolute/path/to/corporate-bundle.pem

# If your workstation already defines this for Python/curl, atlas_ping forwards it unless you omit it:

## SSL_CERT_FILE=/absolute/path/to/corporate-bundle.pem

# Last resort only — disables verification (insecure):

## MONGODB_TLS_ALLOW_INVALID=1

# --- Next.js `GET /api/mongo/ping`: include stack traces in error JSON (avoid in prod) ---
#
## MONGO_PING_VERBOSE_ERRORS=1
